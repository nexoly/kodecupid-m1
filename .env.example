###############################################################################
# KodeCupid — environment template
#
# Copy to `.env` (repo root) for docker-compose, and to `apps/api/.env` /
# `apps/web/.env.local` for the apps. Values below are safe development
# defaults; every secret MUST be replaced before staging or production.
###############################################################################

# ─────────────────────────────── Database ───────────────────────────────────
# PostgreSQL 16 with PostGIS. Local Docker: use the docker-compose service.
# Staging: Neon (PostgreSQL 16 + PostGIS), both URLs with `sslmode=require`.
# Production later: AWS RDS PostgreSQL — only these two values change.
#
# Neon/Postgres poolers break DDL and advisory locks, so there are two URLs:
#   DATABASE_URL           → pooled, used by the running NestJS application
#   DATABASE_URL_UNPOOLED  → direct, used ONLY by Prisma CLI + seed scripts
# Local Postgres has no pooler: set only DATABASE_URL there.
DATABASE_URL="postgresql://kodecupid:kodecupid@localhost:5432/kodecupid?schema=public&sslmode=disable"
DATABASE_URL_UNPOOLED=""
# Only needed if you use `prisma migrate dev` with a shadow database.
# SHADOW_DATABASE_URL=""

# Used by docker-compose.yml only
POSTGRES_USER=kodecupid
POSTGRES_PASSWORD=kodecupid
POSTGRES_DB=kodecupid
POSTGRES_PORT=5432

# ─────────────────────────────── API (apps/api) ──────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Public origin of the API (used for absolute upload URLs)
PUBLIC_API_URL="http://localhost:4000"

# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS="http://localhost:3000"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me-0000000000000000000000000000"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-00000000000000000000000"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Set to true on HTTPS deployments so cookies are `Secure`
COOKIE_SECURE=false

# ──────────────────────────────── SMS / OTP ──────────────────────────────────
# console  -> OTP is written to the API log (development only)
# twilio   -> real SMS via Twilio
SMS_PROVIDER=console
SMS_SENDER_NAME=KodeCupid

# Development: OTP_DEBUG_CODE works for any phone and is echoed by the API.
# Staging: it works ONLY for numbers in OTP_DEBUG_PHONES and is never echoed;
#          every other number must pass the real SMS code.
# Production: refused at boot.
OTP_DEBUG_CODE=246810
OTP_ALLOW_DEBUG_CODE=true
# Staging example (the fictional seeded members):
# OTP_DEBUG_PHONES="+8801711000001,+14155550101,+14155550102,+14155550103,+14155550104"
OTP_DEBUG_PHONES=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Recommended: Twilio Verify service SID (VA...). When set, Twilio generates,
# sends and checks the code and TWILIO_FROM_NUMBER is not needed.
TWILIO_VERIFY_SERVICE_SID=""

# ──────────────────────────────── Storage ────────────────────────────────────
# local -> apps/api/storage (dev / Railway volume)
# s3    -> any S3-compatible bucket (needs the S3_* values)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/api/v1/files"

S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ────────────────────────────── Legal documents ──────────────────────────────
# Bump any version to force every member to re-accept that document.
TERMS_VERSION=1.0
GUIDELINES_VERSION=1.0
SAFETY_TIPS_VERSION=1.0
PRIVACY_VERSION=1.0

# ──────────────────────────────── Seed data ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@kodecupid.test
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
SEED_MODERATOR_EMAIL=moderator@kodecupid.test
SEED_MODERATOR_PASSWORD=ChangeMe!Mod1

# ──────────────────────────────── Web (apps/web) ─────────────────────────────
# Server-side target for the /api/* rewrite proxy (not exposed to the browser)
API_PROXY_TARGET="http://localhost:4000"
NEXT_PUBLIC_APP_NAME=KodeCupid
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
